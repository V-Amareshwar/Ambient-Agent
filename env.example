# .env.example
# Copy this file to .env and fill in your actual values

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LLM SELECTION (Enable ONE)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Use Groq (fast, free tier available)
USE_GROQ=true
# USE_GEMINI=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# API KEYS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Groq API Key (get from: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google API Key (get from: https://aistudio.google.com)
# GOOGLE_API_KEY=your_google_api_key_here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MODEL SELECTION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

GROQ_MODEL=llama3-70b-8192
# GEMINI_MODEL=gemini-1.5-flash

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TOOL MODE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Set to 'true' to use real Gmail/Calendar
# Set to 'false' for mock/testing mode
USE_REAL_TOOLS=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# KEY ROTATION (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# If your main key hits rate limits, add backup keys
# The system will automatically rotate to the next available key

# GROQ_API_KEY=backup_key_1
# GROQ_API_KEY=backup_key_2

# GOOGLE_API_KEY_1=backup_key_1
# GOOGLE_API_KEY_2=backup_key_2
